{
  "manifest_version": 3,
  "name": "ICU.Live Shield",
  "version": "1.0.12",
  "description": "Envía a ICU.Live la cantidad exacta de suscriptores de tu canal que muestra YouTube Studio. Nada más.",
  "homepage_url": "https://icu.live",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://cdn.icu.live/shield/*"
  ],
  "background": {
    "scripts": [
      "bg.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ICU.Live Shield",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://cdn.icu.live/shield/vincular.php*"
      ],
      "js": [
        "link-page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "shield@icu.live",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  }
}
